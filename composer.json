{
    "name": "blakesimpson.dev/laminas-api-sample",
    "description": "Laminas backend API sample",
    "type": "project",
    "authors": [
        {
            "name": "Blake Simpson",
            "email": "blakesimpson.dev@outlook.com"
        }
    ],
    "license": "MIT",
    "keywords": [
        "laminas",
        "api",
        "pathofexile"
    ],
    "require": {
        "php": "~8.5.0",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7",
        "laminas/laminas-diactoros": "^3.8",
        "laminas/laminas-inputfilter": "^2.35",
        "laminas/laminas-router": "^3.19",
        "laminas/laminas-servicemanager": "^3.24",
        "laminas/laminas-validator": "^2.65",
        "roave/psr-container-doctrine": "^6.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "LaminasApiSample\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaminasApiSampleTest\\": "test/"
        }
    },
    "scripts": {
        "clear-config-cache": "php bin/clear-config-cache.php",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S 0.0.0.0:8080 -t public public/index.php"
        ]
    },
    "scripts-descriptions": {
        "clear-config-cache": "Clears merged config cache. Required for config changes to be applied.",
        "cs-check": "Run coding standards checks.",
        "cs-fix": "Automatically fix coding standard issues.",
        "serve": "Start the built-in PHP web server and serve the API sample."
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
