# Copy to .env/.env.local and adjust: cp .env.example .env
# Values here are local dev defaults only!

# PostgreSQL
# Inside Docker Compose, the php service overrides this with it's own service
# name: DB_HOST=postgres; localhost applies to `composer serve` outside
DB_HOST=localhost

# Database name - postgres container creates it on first start
DB_NAME=sample_db

# Database user - postgres container creates it on first start
DB_USER=your_user_name

# Password for DB_USER - postgres image refuses to start with an empty password
DB_PASSWORD=changeme

# Redis
# Inside Docker Compose, the redis service overrides this with it's own service
# name: REDIS_HOST=redis; localhost applies to `composer serve` outside
REDIS_HOST=localhost
