{
    "openapi": "3.1.0",
    "info": {
        "title": "laminas-api-sample",
        "version": "0.1.0",
        "license": {
            "name": "MIT",
            "identifier": "MIT"
        },
        "description": "Fictitious backend modelled on a slice of the Path of Exile public API. Not affiliated with or endorsed by Grinding Gear Games. Unsupported methods on a known path return 405 (code 9) with an Allow header."
    },
    "servers": [
        {
            "url": "/",
            "description": "Same origin as Swagger UI (Nginx on :8000)"
        }
    ],
    "security": [
        {
            "bearer": []
        }
    ],
    "components": {
        "securitySchemes": {
            "bearer": {
                "type": "http",
                "scheme": "bearer",
                "description": "Mocked resource-server auth. Paste a dev token: dev-token-full (all scopes), dev-token-profile-only (403 on /item-filter), dev-token-expired (401), dev-token-revoked (401), dev-token-other-profile (ProfileTwo; ProfileOne's filters are 404). Each operation's scope is in its description and x-required-scope."
            }
        },
        "parameters": {
            "ItemFilterId": {
                "name": "id",
                "in": "path",
                "required": true,
                "schema": {
                    "type": "string",
                    "format": "uuid"
                }
            }
        },
        "schemas": {
            "Error": {
                "type": "object",
                "additionalProperties": false,
                "required": ["error"],
                "properties": {
                    "error": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["code", "message"],
                        "properties": {
                            "code": {
                                "type": "integer",
                                "example": 1
                            },
                            "message": {
                                "type": "string",
                                "example": "Resource not found"
                            }
                        }
                    }
                }
            },
            "ItemFilter": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "filter_name",
                    "realm",
                    "description",
                    "version",
                    "type",
                    "public"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "filter_name": {
                        "type": "string"
                    },
                    "realm": {
                        "type": "string",
                        "enum": ["pc", "xbox", "sony", "poe2"]
                    },
                    "filter": {
                        "type": "string",
                        "description": "Omitted when the filter has no content."
                    },
                    "description": {
                        "type": "string"
                    },
                    "version": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string",
                        "enum": ["Normal", "Ruthless"]
                    },
                    "public": {
                        "type": "boolean"
                    }
                }
            },
            "ItemFilterListItem": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "filter_name",
                    "realm",
                    "description",
                    "version",
                    "type",
                    "public"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "filter_name": {
                        "type": "string"
                    },
                    "realm": {
                        "type": "string",
                        "enum": ["pc", "xbox", "sony", "poe2"]
                    },
                    "description": {
                        "type": "string"
                    },
                    "version": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string",
                        "enum": ["Normal", "Ruthless"]
                    },
                    "public": {
                        "type": "boolean"
                    }
                }
            },
            "Profile": {
                "type": "object",
                "additionalProperties": false,
                "required": ["uuid", "name"],
                "properties": {
                    "uuid": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string"
                    },
                    "locale": {
                        "type": "string",
                        "description": "Omitted when not set."
                    },
                    "twitch": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["name"],
                        "description": "Present if the account is Twitch-linked.",
                        "properties": {
                            "name": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "ItemFilterCreate": {
                "type": "object",
                "required": ["filter_name", "realm", "filter"],
                "properties": {
                    "filter_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255
                    },
                    "realm": {
                        "type": "string",
                        "enum": ["pc", "xbox", "sony", "poe2"]
                    },
                    "filter": {
                        "type": "string",
                        "minLength": 1
                    },
                    "description": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "version": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "type": {
                        "type": "string",
                        "enum": ["Normal", "Ruthless"]
                    },
                    "public": {
                        "type": "boolean",
                        "default": false
                    }
                }
            },
            "ItemFilterUpdate": {
                "type": "object",
                "description": "Partial update: only the keys sent are changed.",
                "properties": {
                    "filter_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255
                    },
                    "realm": {
                        "type": "string",
                        "enum": ["pc", "xbox", "sony", "poe2"]
                    },
                    "filter": {
                        "type": "string",
                        "minLength": 1
                    },
                    "description": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "version": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "type": {
                        "type": "string",
                        "enum": ["Normal", "Ruthless"]
                    },
                    "public": {
                        "const": true,
                        "description": "A filter can be made public, never private again."
                    }
                }
            }
        },
        "responses": {
            "BadRequest": {
                "description": "Malformed JSON (code 2) or missing/unexpected Content-Type (code 5).",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "Unauthorized": {
                "description": "Missing, unknown, expired or revoked token (code 8).",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                },
                "headers": {
                    "WWW-Authenticate": {
                        "schema": {
                            "type": "string"
                        },
                        "example": "Bearer error=\"invalid_token\""
                    }
                }
            },
            "Forbidden": {
                "description": "The token lacks the operation's scope (code 6).",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                },
                "headers": {
                    "WWW-Authenticate": {
                        "schema": {
                            "type": "string"
                        },
                        "example": "Bearer error=\"insufficient_scope\", scope=\"account:item_filter\""
                    }
                }
            },
            "NotFound": {
                "description": "Unknown id, or a filter owned by another profile (code 1).",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "Unprocessable": {
                "description": "A field failed validation (code 10).",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "ServerError": {
                "description": "Internal error (code 4).",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            }
        }
    },
    "paths": {
        "/profile": {
            "get": {
                "operationId": "getProfile",
                "summary": "Get the token owner's profile",
                "description": "Requires scope `account:profile`.",
                "x-required-scope": "account:profile",
                "responses": {
                    "200": {
                        "description": "The profile.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Profile"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                }
            }
        },
        "/item-filter": {
            "get": {
                "operationId": "listItemFilters",
                "summary": "List the token owner's item filters",
                "description": "Requires scope `account:item_filter`. List items omit the `filter` content.",
                "x-required-scope": "account:item_filter",
                "responses": {
                    "200": {
                        "description": "The owner's filters.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": ["filters"],
                                    "properties": {
                                        "filters": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/ItemFilterListItem"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                }
            },
            "post": {
                "operationId": "createItemFilter",
                "summary": "Create an item filter",
                "description": "Requires scope `account:item_filter`.",
                "x-required-scope": "account:item_filter",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ItemFilterCreate"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The created filter.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": ["filter"],
                                    "properties": {
                                        "filter": {
                                            "$ref": "#/components/schemas/ItemFilter"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "422": {
                        "$ref": "#/components/responses/Unprocessable"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                }
            }
        },
        "/item-filter/{id}": {
            "parameters": [
                {
                    "$ref": "#/components/parameters/ItemFilterId"
                }
            ],
            "get": {
                "operationId": "getItemFilter",
                "summary": "Get one item filter",
                "description": "Requires scope `account:item_filter`.",
                "x-required-scope": "account:item_filter",
                "responses": {
                    "200": {
                        "description": "The filter, including its content.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": ["filter"],
                                    "properties": {
                                        "filter": {
                                            "$ref": "#/components/schemas/ItemFilter"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                }
            },
            "post": {
                "operationId": "updateItemFilter",
                "summary": "Update an item filter (partial)",
                "description": "Requires scope `account:item_filter`. Uses POST for updates, as the documented API does.",
                "x-required-scope": "account:item_filter",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ItemFilterUpdate"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The updated filter.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": ["filter"],
                                    "properties": {
                                        "filter": {
                                            "$ref": "#/components/schemas/ItemFilter"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "422": {
                        "$ref": "#/components/responses/Unprocessable"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                }
            }
        }
    }
}
