[
    {
        "label": "lint",
        "command": "composer lint",
        "cwd": "$ZED_WORKTREE_ROOT",
        "shell": "system",
        "reveal": "always",
    },
    {
        "label": "analyze",
        "command": "composer analyze",
        "cwd": "$ZED_WORKTREE_ROOT",
        "shell": "system",
        "reveal": "always",
    },
    {
        "label": "format",
        "command": "composer format",
        "cwd": "$ZED_WORKTREE_ROOT",
        "shell": "system",
        "reveal": "always",
    },
    {
        "label": "format:check",
        "command": "composer format:check",
        "cwd": "$ZED_WORKTREE_ROOT",
        "shell": "system",
        "reveal": "always",
    },
    {
        "label": "serve",
        "command": "composer serve",
        "cwd": "$ZED_WORKTREE_ROOT",
        "shell": "system",
        "reveal": "always",
    },
]
